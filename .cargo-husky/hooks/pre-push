#!/bin/sh
# Blocks a push unless formatting, lints and tests all pass.
# Installed into .git/hooks by cargo-husky on the next `cargo test`.
# Skip in an emergency: git push --no-verify
set -eu

cd "$(git rev-parse --show-toplevel)"

echo "pre-push: cargo fmt --check"
cargo fmt --check

echo "pre-push: cargo clippy --all-targets"
cargo clippy --all-targets --quiet

echo "pre-push: cargo test"
cargo test --quiet

echo "pre-push: all checks passed"
